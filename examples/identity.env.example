# EXAMPLES ONLY: replace every placeholder after following docs/AUTH0_SETUP.md.
# Application role only. Never give the serving process migration, SMTP or Management credentials.
AUTH0_ISSUER=https://YOUR-TENANT.us.auth0.com/
AUTH0_JWKS_URI=https://YOUR-TENANT.us.auth0.com/.well-known/jwks.json
MCP_RESOURCE_URI=https://YOUR-IDENTITY-SERVICE.up.railway.app/mcp
MCP_EXTERNAL_ORIGIN=https://YOUR-IDENTITY-SERVICE.up.railway.app
AUTH0_ALLOWED_CLIENT_IDS=YOUR-APPROVED-NATIVE-CLIENT-ID
MCP_ALLOWED_ORIGINS=https://YOUR-IDENTITY-SERVICE.up.railway.app
DATABASE_URL=postgresql://mpd_identity_app:REPLACE-WITH-SECRET@YOUR-POSTGRES.railway.internal:5432/identity
DB_TRANSPORT_MODE=railway-private
# Set DB_CA_CERT for verify-full connections only; never disable certificate verification.
AUTHZ_STORE_ID=11111111-1111-4111-8111-111111111111
AUTHZ_DEPLOY_EPOCH=REPLACE-WITH-INITIAL-EPOCH
AUTHZ_TOKEN_IAT_AFTER=0
# An external hard deny; stored maintenance must also be cleared deliberately before admissions.
AUTHZ_MAINTENANCE=true
AUTHZ_ADMIN_SOCKET=/tmp/mpd-identity/admin.sock
HOST=0.0.0.0
PORT=8080
