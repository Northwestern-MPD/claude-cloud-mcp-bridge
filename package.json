{
  "name": "claude-cloud-local-mcp-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "dev:mock": "tsx apps/demo.ts",
    "gateway:mock": "tsx apps/gateway/main.ts",
    "connector": "tsx apps/connector/main.ts",
    "probe": "tsx apps/probe.ts",
    "build:probe": "node scripts/build-probe.mjs",
    "start": "node probe/http.cjs --http"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "jose": "6.2.12",
    "pg": "8.23.1",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.2",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
