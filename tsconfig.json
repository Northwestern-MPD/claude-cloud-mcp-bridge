{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "esModuleInterop": true, "outDir": "dist", "rootDir": ".",
    "skipLibCheck": true, "noUncheckedIndexedAccess": true
  },
  "include": ["apps/**/*.ts", "packages/**/*.ts", "test/**/*.ts", "scripts/**/*.ts"]
}
